# Web (Vercel)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/67songs?retryWrites=true&w=majority
AUTH_SECRET=generate_a_random_32_character_secret_here
AUTH_GOOGLE_ID=your_google_oauth_client_id
AUTH_GOOGLE_SECRET=your_google_oauth_client_secret
SOCKET_SERVER_URL=http://localhost:4000
SOCKET_TOKEN_SECRET=generate_a_random_32_character_jwt_secret_for_socket_tokens
MUSIC_SERVICE_URL=http://localhost:8000
MUSIC_SERVICE_SHARED_SECRET=generate_a_random_shared_secret_here
SENTRY_DSN=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Realtime Service (Railway)
# MONGODB_URI=...
# SOCKET_TOKEN_SECRET=...
PORT=4000
WEB_APP_ORIGIN=http://localhost:3000
ROOM_SNAPSHOT_INTERVAL_MS=15000
MAX_SOCKET_REPLICAS=1

# Music Service (Railway)
# MUSIC_SERVICE_SHARED_SECRET=...
PORT=8000
REQUEST_TIMEOUT_SECONDS=10
